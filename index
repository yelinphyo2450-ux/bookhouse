      </button>

      <!-- VIBER_LINK: နောက်မှ လင့်ခ်ထည့်လျှင် <a href="viber://chat?number=%2B959956728837" class="link-card"> ပြောင်းပါ -->
      <button type="button" class="link-card pending" data-pending="Viber">
        <div class="card-left">
          <span class="icon-badge">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.03 2 11c0 2.7 1.33 5.12 3.42 6.77L4.5 21.5l3.96-1.32C9.58 20.7 10.76 21 12 21c5.52 0 10-4.03 10-9s-4.48-10-10-10zm4.35 12.83c-.22.62-1.28 1.18-1.78 1.25-.46.07-1.03.1-1.66-.1-.39-.12-.89-.29-1.53-.57-2.7-1.16-4.46-3.88-4.6-4.06-.13-.18-1.1-1.46-1.1-2.79 0-1.33.7-1.98.95-2.25.25-.27.54-.34.72-.34h.52c.17.01.39-.06.61.46.22.54.76 1.85.83 1.98.07.13.11.29.02.47-.09.18-.13.29-.27.45-.13.16-.28.35-.4.47-.13.13-.27.28-.12.54.16.27.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.13.43.11.58-.07.16-.18.67-.78.85-1.05.18-.27.36-.22.61-.13.25.09 1.57.74 1.84.88.27.13.45.2.52.31.07.11.07.65-.15 1.27z"/></svg>
          </span>
          <div class="card-text">
            <span class="card-title">Viber</span>
            <span class="card-sub">လင့်ခ် ထပ်မံဖြည့်သွင်းရန်</span>
          </div>
