      </button>
    </div>

    <!-- ၂။ TikTok -->
    <div class="section-head">တရားဝင် စာမျက်နှာ</div>
    <div class="stack">
      <a href="https://www.tiktok.com/@bookhouse33" target="_blank" rel="noopener noreferrer" class="link-card">
        <div class="card-left">
          <span class="icon-badge">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.3 0 .6.05.88.13V9.4a6.33 6.33 0 0 0-7.33 6.27A6.34 6.34 0 0 0 15.86 15.7v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4c-.35 0-.7-.04-1.04-.13z"/></svg>
          </span>
          <div class="card-text">
            <span class="card-title">TikTok — စာအုပ်အိမ်</span>
            <span class="card-sub">tiktok.com/@bookhouse33</span>
          </div>
        </div>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
