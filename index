    <!-- ၃။ နောက်မှ လင့်ခ်ထပ်ဖြည့်ရန် (Facebook / Viber / Telegram) -->
    <div class="section-head">အခြား ဆက်သွယ်ရန် လမ်းကြောင်းများ</div>
    <div class="stack">
      <!-- FB_LINK: နောက်မှ လင့်ခ်ထည့်လျှင် ဤ button ကို <a href="YOUR_FB_URL" target="_blank" rel="noopener noreferrer" class="link-card"> ပြောင်းပါ -->
      <button type="button" class="link-card pending" data-pending="Facebook Page">
        <div class="card-left">
          <span class="icon-badge">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.33-.04-1.56-.14-2.86-.14-2.71 0-4.64 1.66-4.64 4.7v2.8H7v4h3V22h4v-8.5z"/></svg>
          </span>
          <div class="card-text">
            <span class="card-title">Facebook Page</span>
            <span class="card-sub">လင့်ခ် ထပ်မံဖြည့်သွင်းရန်</span>
