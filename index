    </footer>
  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    // Subtle warm sunlit dust motes on paper background
    const canvas = document.getElementById('sunlight-canvas');
    const ctx = canvas.getContext('2d');
    let cw = 0;
    let ch = 0;

    function resize() {
      cw = canvas.width = window.innerWidth;
      ch = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    const motes = Array.from({ length: 26 }, () => ({
      x: Math.random() * cw,
      y: Math.random() * ch,
      r: Math.random() * 2.4 + 0.8,
      vx: (Math.random() - 0.5) * 0.25,
      vy: -Math.random() * 0.28 - 0.06,
      alpha: Math.random() * 0.35 + 0.12,
      color: Math.random() > 0.4 ? '#C46D3B' : '#1E3A2F'
    }));

    function tick() {
      ctx.clearRect(0, 0, cw, ch);
      for (const m of motes) {
        m.x += m.vx;
        m.y += m.vy;
        if (m.y < -8) {
          m.y = ch + 8;
          m.x = Math.random() * cw;
        }
        if (m.x < -8) m.x = cw + 8;
        if (m.x > cw + 8) m.x = -8;
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ctx.fillStyle = m.color;
        ctx.globalAlpha = m.alpha;
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(tick);
    }
    tick();

    // Toast helper
    const toastEl = document.getElementById('toast');
    let toastTimer = null;
    function showToast(msg) {
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2600);
    }

    // One-tap Copy Phone Number
    const copyBtn = document.getElementById('copy-phone-btn');
    copyBtn.addEventListener('click', () => {
      const phone = '09-956728837';
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(phone)
          .then(() => showToast('ဖုန်းနံပါတ် 09-956728837 ကို ကူးယူပြီးပါပြီ'))
          .catch(() => fallbackCopy(phone));
      } else {
        fallbackCopy(phone);
      }
    });

    function fallbackCopy(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        showToast('ဖုန်းနံပါတ် 09-956728837 ကို ကူးယူပြီးပါပြီ');
      } catch (e) {
        showToast('09-956728837');
      }
      document.body.removeChild(ta);
    }

    // Pending social link feedback
    document.querySelectorAll('[data-pending]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-pending');
        showToast(name + ' လင့်ခ်ကို မကြာမီ ထည့်သွင်းပေးပါမည် — ဖုန်း 09-956728837 သို့ ဆက်သွယ်နိုင်ပါသည်');
      });
    });
  </script>
</body>
