<!DOCTYPE html>
<html lang="my">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>စာအုပ်အိမ် (Book House) — ဆက်သွယ်ရန်</title>
  <style>
    :root {
      --paper: #FAF7F2;
      --paper-deep: #F1EAE0;
      --sand: #E6D9C5;
      --forest: #1E3A2F;
      --forest-soft: #2A4F40;
      --terracotta: #C46D3B;
      --terracotta-soft: #D98555;
      --ink: #222222;
      --muted: #5C635E;
      --card: #FFFFFF;
      --line: #E3D8C7;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(165deg, #FBF8F3 0%, #F2EAE0 55%, #E8DDD0 100%);
      color: var(--ink);
      font-family: 'Noto Sans Myanmar', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 28px 16px 40px;
      position: relative;
      overflow-x: hidden;
    }

    #sunlight-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    /* Editorial Book-Page Card */
    .book-sheet {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 430px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 22px;
      padding: 36px 24px 28px;
      box-shadow:
        0 24px 50px rgba(30, 58, 47, 0.11),
        0 4px 14px rgba(30, 58, 47, 0.06),
        inset 6px 0 0 var(--forest);
      overflow: hidden;
    }

    /* Hanging Terracotta Bookmark Ribbon at Top-Right */
    .bookmark-ribbon {
      position: absolute;
      top: 0;
      right: 28px;
      width: 28px;
      height: 52px;
      background: var(--terracotta);
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
      box-shadow: 0 4px 10px rgba(196, 109, 59, 0.25);
    }

    /* Header */
    .brand-header {
      text-align: center;
      margin-bottom: 22px;
    }

    .emblem-wrap {
      width: 88px;
      height: 88px;
      margin: 0 auto 14px;
      border-radius: 50%;
      background: var(--forest);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 24px rgba(30, 58, 47, 0.22);
      border: 3px solid var(--sand);
    }

    .emblem-wrap svg {
      width: 58px;
      height: 58px;
    }

    .brand-title {
      font-family: 'Noto Serif Myanmar', Georgia, serif;
      font-size: 25px;
      font-weight: 700;
      color: var(--forest);
      margin: 0 0 4px;
      line-height: 1.35;
    }

    .brand-en {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 2.2px;
      text-transform: uppercase;
      color: var(--terracotta);
      margin: 0 0 12px;
    }

    .tagline {
      font-size: 14px;
      color: var(--muted);
      margin: 0 0 14px;
      line-height: 1.6;
    }

    .cod-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: rgba(196, 109, 59, 0.12);
      color: var(--forest);
      border: 1px solid rgba(196, 109, 59, 0.35);
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 12.5px;
      font-weight: 700;
    }

    .cod-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--terracotta);
      flex-shrink: 0;
    }

    /* Section Divider */
    .section-head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 22px 0 12px;
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
    }

    .section-head::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--line);
    }

    /* Primary Phone Action Row */
    .phone-box {
      display: flex;
      gap: 8px;
      align-items: stretch;
    }

    .link-card {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 15px;
      border-radius: 14px;
      text-decoration: none;
      background: var(--card);
      border: 1px solid var(--line);
      color: var(--ink);
      cursor: pointer;
      font-family: inherit;
      text-align: left;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    }

    .link-card:hover,
    .link-card:focus-visible {
      transform: translateY(-2px);
      border-color: var(--terracotta);
      box-shadow: 0 8px 20px rgba(30, 58, 47, 0.09);
      outline: none;
    }

    .link-card.primary-call {
      background: var(--forest);
      border-color: var(--forest);
      color: var(--paper);
      flex: 1;
    }

    .link-card.primary-call:hover,
    .link-card.primary-call:focus-visible {
      background: var(--forest-soft);
      border-color: var(--terracotta);
      box-shadow: 0 10px 22px rgba(30, 58, 47, 0.24);
    }

    .copy-btn {
      flex-shrink: 0;
      width: 54px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--forest);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      cursor: pointer;
      font-family: inherit;
      font-size: 10.5px;
      font-weight: 700;
      transition: all 0.2s ease;
    }

    .copy-btn:hover {
      border-color: var(--terracotta);
      color: var(--terracotta);
      transform: translateY(-2px);
    }

    .copy-btn svg {
      width: 18px;
      height: 18px;
    }

    .card-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .icon-badge {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: var(--paper-deep);
      color: var(--forest);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .primary-call .icon-badge {
      background: var(--terracotta);
      color: var(--paper);
    }

    .icon-badge svg {
      width: 19px;
      height: 19px;
    }

    .card-text {
      min-width: 0;
    }

    .card-title {
      display: block;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
    }

    .primary-call .card-title {
      font-size: 17px;
      letter-spacing: 0.4px;
    }

    .card-sub {
      display: block;
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .primary-call .card-sub {
      color: var(--sand);
    }

    .chevron {
      width: 18px;
      height: 18px;
      color: var(--terracotta);
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .primary-call .chevron {
      color: var(--sand);
    }

    .link-card:hover .chevron {
      transform: translateX(3px);
    }

    .stack {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* Placeholder / Upcoming Social Slots */
    .link-card.pending {
      background: rgba(255, 255, 255, 0.65);
      border-style: dashed;
      border-color: #CFC2AE;
    }

    .pending-tag {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      background: var(--paper-deep);
      padding: 4px 9px;
      border-radius: 999px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Editorial Footer */
    .sheet-footer {
      margin-top: 24px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
      text-align: center;
      font-size: 12px;
      color: var(--muted);
    }

    /* Toast Notification */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 22px;
      transform: translate(-50%, 16px);
      background: var(--forest);
      color: var(--paper);
      padding: 11px 18px;
      border-radius: 999px;
      font-size: 13px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.24);
      border: 1px solid rgba(196, 109, 59, 0.6);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
      z-index: 50;
      max-width: 90vw;
      text-align: center;
    }

    .toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  </style>
</head>
<body>
  <canvas id="sunlight-canvas"></canvas>

  <main class="book-sheet">
    <div class="bookmark-ribbon" aria-hidden="true"></div>

    <header class="brand-header">
      <div class="emblem-wrap" aria-hidden="true">
        <svg viewBox="0 0 240 220" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 98 L120 26 L160 56 L160 34 L178 34 L178 69.5 L216 98" stroke="#C46D3B" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M48 96 L48 168 C78 168 102 174 120 186 C138 174 162 168 192 168 L192 96" stroke="#FAF7F2" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M66 90 C88 86 108 94 120 112 C132 94 152 86 174 90 L174 152 C152 148 132 156 120 172 C108 156 88 148 66 152 Z" stroke="#C46D3B" stroke-width="7.5" stroke-linejoin="round"/>
