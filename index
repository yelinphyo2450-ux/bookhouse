      <!-- TG_LINK: နောက်မှ လင့်ခ်ထည့်လျှင် <a href="https://t.me/YOUR_USERNAME" target="_blank" rel="noopener noreferrer" class="link-card"> ပြောင်းပါ -->
      <button type="button" class="link-card pending" data-pending="Telegram">
